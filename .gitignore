# Dependencies
node_modules/
bun.lock

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Compiled documents
*.pdf
*.aux
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# Personal data (never commit these)
salary_data.json
job_scraper/seen_jobs.json
job_scraper/*.md
*_BehavioralReport.pdf
linkedin_Profile.pdf

# Personal photos and signatures
*.jpg
*.jpeg
*.png
!cover_letters/OpenFonts/fonts/**

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Memory files (Claude Code user-specific)
.claude/projects/

# Skills lock (auto-generated)
skills-lock.json

# Personal application output files (generated by /apply — do not share)
cv/main_*.tex
!cv/main_example.tex
cover_letters/cover_*.tex
cover_letters/Cover_*.tex

# documents/ subfolder contents are personal — only README and folder structure are tracked
documents/cv/**
documents/linkedin/**
documents/diplomas/**
documents/references/**
documents/applications/**
!documents/**/.gitkeep

# Personal job search tracking
job_search_tracker.csv

# Upskill reports (personal output)
upskill/*.md

# Agent usage logs
.agents/

# Database (personal job search data)
data/

# Personal application state (never commit)
applications/
postings/

# Personal scraper configuration
.opencode/skills/job-scraper/frontier-rolodex.json
.opencode/skills/job-scraper/board-list.md
.opencode/skills/job-scraper/cdp_search.py
.opencode/skills/job-scraper/search-queries.md

# opencode runtime artifacts
.opencode/node_modules/
.opencode/__pycache__/

# Resume files (catch-all for future)
*Resume.md
*resume.md
*CV.md
*cv.md

# Scraper runtime data (any future JSON/MD in scraper skill dir, excluding SKILL.md)
.opencode/skills/job-scraper/*.json
.opencode/skills/job-scraper/*.md
!.opencode/skills/job-scraper/SKILL.md
